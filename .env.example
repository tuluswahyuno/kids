# Salin menjadi .env.local lalu isi. JANGAN commit .env.local.

# Supabase (akun orang tua, sinkronisasi progres, entitlement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk pengembangan: tombol "buka premium" tanpa bayar. Harus 0/kosong di produksi.
NEXT_PUBLIC_DEV_UNLOCK=0

# Mode gratis (bawaan): semua terbuka. Set 0 untuk mengaktifkan kunci premium + paywall.
NEXT_PUBLIC_FREE_MODE=1

# RevenueCat (Play Billing) — kunci publik per platform
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
